{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "framework": null,
  "installCommand": "pnpm install",
  "buildCommand": "pnpm --filter @comic/frontend build && pnpm --filter @comic/backend exec tsx scripts/bundle-api.ts && npm install --prefix api --omit=dev",
  "outputDirectory": "apps/frontend/dist",
  "functions": {
    "api/[[...path]].mjs": {
      "maxDuration": 60
    }
  },
  "rewrites": [
    { "source": "/((?!api/).*)", "destination": "/index.html" }
  ],
  "headers": [
    {
      "source": "/assets/(.*)",
      "headers": [{ "key": "Cache-Control", "value": "public, max-age=31536000, immutable" }]
    }
  ]
}
