# Comic reader — operator config
# Copy to apps/backend/.env (or export in your process manager) and fill in.
# The app ships with NO third-party content sources. You choose where files live.

# --- Telegram ---
TELEGRAM_BOT_TOKEN=
JWT_SECRET=replace-with-a-long-random-string-at-least-32-chars
# Mini App origin(s), comma-separated. Use * only while developing.
CORS_ORIGINS=https://your-mini-app.example.com

# --- Your comic library (pick one or both) ---

# 1) Folder of CBZ/ZIP on disk
#    Expected layout:
#      LIBRARY/
#        Series Name/
#          Chapter 01.cbz
#          Chapter 02.cbz
#        One Shot.cbz
LOCAL_LIBRARY_DIR=

# 2) Your OPDS server (Kavita / Komga / Calibre-Web / …)
#    Format: label|url|username|password   (user/pass optional)
#    Several catalogs: comma-separated entries
#    Example: Home|https://komga.example.com/opds|alice|secret
OPDS_CATALOGS=

# 3) com-x.life HTML adapter (catalog / search / chapters / reader pages)
#    Off by default. Set true to enable.
#    The site runs an anti-bot PoW gate and currently requires a DLE login
#    for the catalog — set COMX_LOGIN / COMX_PASSWORD to your site account.
COMX_ENABLED=false
COMX_LOGIN=
COMX_PASSWORD=

# Allow OPDS on a private/LAN IP (off by default — SSRF protection).
ALLOW_PRIVATE_UPSTREAM=false

# Extra hosts the image proxy may reach (beyond those implied by OPDS_CATALOGS).
PROXY_EXTRA_HOSTS=

# --- Optional tuning ---
HOST=0.0.0.0
PORT=8787
IMAGE_CACHE_DIR=
IMAGE_WEBP_QUALITY=82
ARCHIVE_MAX_BYTES=157286400
